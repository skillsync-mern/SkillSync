# Copy to server/.env and adjust.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/skillsync
# Used only by `npm test`. Tests wipe this database, so never point it at real data.
MONGO_URI_TEST=mongodb://127.0.0.1:27017/skillsync_test
# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Origin allowed by CORS when the client runs on its own dev server
CLIENT_URL=http://localhost:5173
# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@skillsync.dev
ADMIN_PASSWORD=Admin123!
